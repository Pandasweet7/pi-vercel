# ── Site access: HTTP Basic Auth (required) ─────────────────────────────────
# Also derives the per-user sandbox name via fnv1a(SITE_USERNAME).
SITE_USERNAME=
SITE_PASSWORD=

# ── Model provider (required*): AI gateway OR any BYOK key below ────────────
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6

# ── BYOK: bring your own keys (optional; any subset) ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
BASETEN_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
AZURE_OPENAI_API_KEY=

# ── Sandbox tuning (optional) ────────────────────────────────────────────────
# Session wall-clock lifetime before auto-stop; extended on activity (ms).
SANDBOX_TIMEOUT_MS=300000
# Sandbox region: iad1 | sfo1 | cle1 | cdg1 (no Asia regions yet).
SANDBOX_REGION=iad1
# VCR image ref for v2 custom image. Leave empty for managed image + npm install.
SANDBOX_IMAGE=
# How long to wait for pi-web-server readiness after boot (ms).
SANDBOX_READY_TIMEOUT_MS=120000
# Snapshot TTL in ms. 0 = never expire.
SANDBOX_SNAPSHOT_EXPIRATION_MS=0
# Keep only the N most recent snapshots (1–10).
SANDBOX_KEEP_LAST_SNAPSHOTS=2
# vCPU count (2048 MB RAM per vCPU).
SANDBOX_VCPUS=2
