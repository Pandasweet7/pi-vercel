# ── Site access: HTTP Basic Auth (required) ────────────────────────────────
# Also derives the per-user sandbox name (fnv1a of SITE_USERNAME).
SITE_USERNAME=
SITE_PASSWORD=

# ── Model provider (required*): AI gateway OR any BYOK key below ───────────
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ── BYOK: bring your own keys (optional; any subset) ───────────────────────
# The sandbox has outbound network, so pi calls these endpoints directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# ── Sandbox tuning (optional) ────────────────────────────────────────────────
# Single session wall-clock before auto-stop (ms). Default 5 min; extend on activity.
SANDBOX_TIMEOUT_MS=300000
# Region: iad1 (default) | sfo1 | cle1 | cdg1. NOTE: no Asia region.
SANDBOX_REGION=iad1
# VCR image ref for the pi-web container (v2). Leave empty for managed image + install at onCreate (v1).
SANDBOX_IMAGE=
