{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/proxy" },
    {
      "source": "/((?!api/proxy/)(?!api/ping)(?!api/selftest)(?!api/report)(?!api/probe)(?!api/fetchlog)(?!api/exec).*)",
      "destination": "/api/proxy/$1"
    }
  ]
}
